    "pyodide": "314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-static-copy": "^3.4.0",
